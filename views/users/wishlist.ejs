<% layout("layouts/boilerplate.ejs") -%>

<div class="row justify-content-center mt-4 mb-4">
	<div class="col-12 col-lg-10">
		<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
			<h3 class="mb-0"><%= user.username %>'s Wishlist</h3>
			<a href="/listings" class="btn btn-outline-dark btn-sm">Explore Listings</a>
		</div>

		<% if (wishlist.length === 0) { %>
			<div class="card shadow-sm p-4 text-center">
				<p class="mb-3 text-muted">Your wishlist is empty. Start adding your favourite stays.</p>
				<a href="/listings" class="btn btn-dark">Browse Listings</a>
			</div>
		<% } else { %>
			<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mb-4">
				<% wishlist.forEach((listing) => { %>
					<div class="col">
						<div class="card listing-card h-100">
							<a href="/listings/<%= listing._id %>" class="listing-link">
								<img
									src="<%= listing.image.url %>"
									class="card-img-top"
									alt="<%= listing.title %>"
									style="height: 14rem; object-fit: cover;"
								>
							</a>
							<div class="card-body d-flex flex-column">
								<h5 class="card-title mb-1"><%= listing.title %></h5>
								<p class="text-muted mb-1"><%= listing.location %>, <%= listing.country %></p>
								<p class="mb-3"><strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
								<form class="mt-auto" method="POST" action="/users/wishlist/<%= listing._id %>?_method=DELETE">
									<button class="btn btn-outline-danger w-100">
										<i class="fa-solid fa-heart-crack me-1"></i> Remove
									</button>
								</form>
							</div>
						</div>
					</div>
				<% }) %>
			</div>
		<% } %>
	</div>
</div>

